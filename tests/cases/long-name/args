# A display name of 1000 characters.  mkHeaders takes values up to 2000 bytes,
# and a name in ASCII is written on one line, which here is longer than the
# 998 characters RFC 5322 allows.
mode=accept
tls=none
form=(From="$(printf 'N%.0s' $(seq 1 1000)) <alice@example.com>" To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
