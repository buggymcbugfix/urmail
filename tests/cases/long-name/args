# A display name of 1000 characters, one word that fits on no line: written
# as encoded words, which fold, so that no line is longer than the 78
# characters RFC 5322 asks for, let alone the 998 it allows.
mode=accept
tls=none
form=(From="$(printf 'N%.0s' $(seq 1 1000)) <alice@example.com>" To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
