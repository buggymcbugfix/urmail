# libcurl's proxy variables are honoured as they are: with all_proxy
# naming a proxy where nothing listens, the connection goes to the proxy
# and not to the server, which sees no client.  The send is deferred.
# no_proxy is emptied so that the test does not depend on the one of the
# environment it runs in.
mode=accept
tls=none
app_env=(all_proxy=http://127.0.0.1:9 no_proxy= NO_PROXY=)
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
