# The server accepts STARTTLS and closes the connection instead of the
# handshake.  The status is Failed, "fails the same way until the
# configuration is changed", as for a certificate that does not verify,
# although a connection lost in the handshake may be gone the next time.
mode=starttls-drop
tls=starttls-ca
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Secret\n' User=alice Password=secret)
