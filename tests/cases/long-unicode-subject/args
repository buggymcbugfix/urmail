# A long subject that is not ASCII: encoded words of at most 45 bytes each,
# cut between characters, so that each decodes on its own (RFC 2047 6.3).
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Body=$'Hi\n' User=alice Password=secret
      Subject="$(for i in $(seq 40); do printf 'Grüße €'; done)")
