# A display name of 996 characters that needs quotes (it has dots), so the
# quoted string is 998 long and no longer fits on a line.  The name is
# encoded then, without the quotes: a reader decodes the 996 characters
# and nothing else.  (name-quoted-997 is one character shorter.)
mode=accept
tls=none
form=(From="$(printf 'a.%.0s' $(seq 1 498)) <alice@example.com>" To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
