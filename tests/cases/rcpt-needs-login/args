# No login, and the server refuses to relay to the recipient with 550
# 5.7.0: a login is needed, which the configuration is to give, so the
# status is Misconfigured, though the reply answers RCPT TO.
mode=rcpt-needs-login
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n')
