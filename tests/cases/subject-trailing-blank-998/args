# A subject of 997 letters and one blank, 998 bytes, the most allowed. The
# letters fill the line after the fold at the colon, 998 bytes with the
# blank in front, so there is no room for the blank after them, and a line
# of only blanks is not allowed. The word is encoded then, and the blank
# comes after it.
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Body=$'Hi\n' User=alice Password=secret
      Subject="$(printf 'w%.0s' $(seq 997)) ")
