# URMAIL_TIMEOUT=" 5": a number with a blank in front is not one of digits
# alone, as "5 " is not (timeout-env): one line on stderr, and the default
# is used.
mode=accept
tls=none
app_env=("URMAIL_TIMEOUT= 5")
logfilter='^urmail: URMAIL_TIMEOUT'
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
