# An smtps:// URL for a server that does not speak TLS on that port: libcurl
# starts the handshake, the server answers in plain text, and the handshake
# fails with "wrong version number".  That does not change by waiting, so it
# is for the person who set the address up to put right, but the library
# says Deferred, as for a connection lost in the handshake, and a queue
# that tries again on Deferred tries for ever.  The expected file records
# what the library writes today, not what it should write.
mode=accept
tls=none
url=smtps
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
