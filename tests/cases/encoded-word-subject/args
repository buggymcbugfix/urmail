# A subject in ASCII that has the shape of an RFC 2047 encoded word is written
# as it is, and a mail client shows what it decodes to ("Hello"), not the text.
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject='=?UTF-8?B?SGVsbG8=?=' Body=$'Hi\n' User=alice Password=secret)
