# After the first message the server drops the connection that the application
# keeps open, at the next MAIL FROM and without a reply, as a server does that
# closed an idle session.  Nothing of the second message was sent, so the
# library sends it once more, on a new connection.
mode=drop-on-reuse
tls=none
sends=2
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
