# A Message-ID that is not ASCII passes the checks and goes into the header
# as raw UTF-8, which RFC 5322 does not allow and the library does not
# negotiate SMTPUTF8 for.  Every other header value that is not ASCII is
# encoded.
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret
      MessageId='<bestellung-ä@example.com>')
