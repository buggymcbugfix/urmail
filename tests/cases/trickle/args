# The server reads the message at 512 bytes per second, and the message is
# 8 MB, more than the socket buffers hold: the upload crawls, below the
# 1 KiB/s the library wants, and is given up after URMAIL_TIMEOUT (run.sh's
# urmail_timeout, 2 s) of that, as the trace line shows.  Not all of the
# message went out, so the status is Deferred.
mode=trickle
tls=none
app_env=(URMAIL_DEBUG=1)
logfilter='^\* Operation'
form=(From=alice@example.com To=bob@example.net Subject=Big Body=$'See attached\n' User=alice Password=secret
      Attach1='big|big.txt|text/plain|8000000')
