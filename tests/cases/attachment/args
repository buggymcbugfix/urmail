# One attachment on a text-only message: multipart/mixed of the text and the
# file, base64 in 76-character lines (the data is 60 bytes, so two).
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Notes Body=$'See attached\n' User=alice Password=secret
      Attach1=$'blob|notes.txt||text/plain|Line one of the notes.\nLine two, a bit longer than the first.\n')
