# Addresses with text after a '>': what follows it would go into the envelope
# as ESMTP parameters (SMTPUTF8 on MAIL FROM, NOTIFY=NEVER on RCPT TO), so
# the address is refused before anything is sent.
api=check
mode=accept
tls=none
form=(From='alice@example.com> SMTPUTF8 <alice@example.com' To='bob@example.net> NOTIFY=NEVER <bob@example.net' Subject=Hello Body=$'Hi\n' User=alice Password=secret)
