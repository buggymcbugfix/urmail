# Three attachments on a message with an HTML part: multipart/mixed of the
# alternative and the three files, in the order given.  The second name has
# quotes, escaped in filename=.  The third is not ASCII: it goes into an RFC
# 2231 filename*, and filename= has a copy with '_' for each character that
# is not ASCII.
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Plain text\n' Html=world User=alice Password=secret
      Attach1='blob|a.txt|text/plain|A'
      Attach2='blob|"quoted" name.txt|text/plain|B'
      Attach3='blob|Notizen über Ä.txt|text/plain|C')
