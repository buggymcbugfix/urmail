# An image of the HTML given in Images, for the url the page uses: the page
# would show it from that url in a browser; in the mail it goes in a
# multipart/related with the alternative, and the src points at its
# Content-ID.
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Logo Body=$'Plain text\n' Html=world Srcs=/chart User=alice Password=secret
      Attach1='image-blob|/chart|logo.png|image/png|not really a png')
