# What the quoted-printable encoder does at the start of a line, which some
# mail systems change: a "From " (mbox delivery writes ">From "), one that
# a soft line break moves there, a "Fromage" and a "from " (left alone by
# mbox), a line of a single '.' (which would end the DATA) and a line
# starting with '.'.
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Starts User=alice Password=secret
      Body="From here
$(printf 'x%.0s' $(seq 75))From there
Fromage
from below
.
.dot")
