# The server offers no AUTH mechanism that libcurl can use with a password
# (XOAUTH2 alone): libcurl gives up before sending a command, "Login
# denied".  Every try fails the same way until the configuration changes:
# Misconfigured.
mode=auth-xoauth2
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Hello Body=$'Hi\n' User=alice Password=secret)
