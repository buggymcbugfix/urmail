# Attachments whose sizes meet the edges of base64: two bytes (one '=' of
# padding, the three-byte groups leave two over), 57 bytes (one full line of
# 76 characters and no break after it) and 58 bytes (a second line of four).
mode=accept
tls=none
form=(From=alice@example.com To=bob@example.net Subject=Sizes Body=$'See attached\n' User=alice Password=secret
      Attach1='blob|two.txt||text/plain|ab'
      Attach2="blob|line.txt||text/plain|$(printf 'a%.0s' $(seq 1 57))"
      Attach3="blob|more.txt||text/plain|$(printf 'b%.0s' $(seq 1 58))")
